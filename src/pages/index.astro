---
// Home page. Section order follows the atcrubbers.com home page:
// hero → what we make → why choose us → services & support → industries → testimonials → CTA → footer.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import IndustryArt from '../components/IndustryArt.astro';
import IndustryTabs from '../components/IndustryTabs.astro';
import Why from '../components/Why.astro';
import Testimonials from '../components/Testimonials.astro';
import Enquiry from '../components/Enquiry.astro';
import { site, stats } from '../data/site';
import { services } from '../data/services';
import { categories, products } from '../data/products';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/home/hero-moulding.jpg';
import servicePhoto from '../assets/home/service-mould.jpg';

// Photo used for each product category card (files in src/assets/industries/).
const catPhoto: Record<string, string> = { motor: 'motors', pump: 'pumps', conveyor: 'conveyors', food: 'dairy', chemical: 'chemical', rubber: 'rubber', engineering: 'automotive' };
const productCats = categories.map((c) => ({ ...c, items: products.filter((p) => p.category === c.id) }));
---
<Layout>
	<!-- HERO -->
	<section class="hero">
		<div class="wrap hero-grid">
			<div>
				<span class="since">SINCE {site.since} · GUJARAT, INDIA</span>
				<h1>Your partner in <span>precision moulding.</span></h1>
				<p class="lede">Top-quality plastic and rubber moulding with 25+ years of manufacturing excellence. We combine scale and precision to craft custom components for motors, pumps, conveyors, dairy, chemical and automotive industries — from mould design to mass production, under one roof.</p>
				<div class="hero-actions">
					<a href="/products/" class="btn btn-amber">Explore products <Icon name="arrow" stroke={2.4} /></a>
					<a href="/contact/#enquiry" class="btn btn-ghost">Request a quote</a>
				</div>
				<ul class="hero-ticks">
					<li><Icon name="check" size={16} stroke={2.6} />In-house mould design</li>
					<li><Icon name="check" size={16} stroke={2.6} />Plastic + rubber</li>
					<li><Icon name="check" size={16} stroke={2.6} />Export-ready</li>
				</ul>
			</div>

			<figure class="hero-photo">
				<Image src={heroPhoto} alt="Operator running an injection moulding machine, with the open mould on the left and a finished moulded plastic part on the inspection table" widths={[560, 900, 1300]} sizes="(max-width: 1050px) 100vw, 560px" loading="eager" fetchpriority="high" />
				<figcaption><b>Plastic injection moulding</b><span>40,000+ parts a day, from mould design to dispatch</span></figcaption>
			</figure>
		</div>

		<div class="hero-stats">
			<dl class="wrap">
				{stats.map((s) => (
					<div class="hs"><dt>{s.value}{s.unit && <em>{s.unit}</em>}</dt><dd>{s.label}</dd></div>
				))}
			</dl>
		</div>
	</section>

	<!-- WHAT WE MAKE -->
	<section class="section" id="products">
		<div class="wrap">
			<div class="head-row reveal">
				<div>
					<span class="eyebrow">What we make</span>
					<h2>Our product range</h2>
					<p class="lede">Plastic and rubber parts for motors, pumps, conveyors, dairy, chemical and engineering applications — each made to your drawing or sample.</p>
				</div>
				<a href="/products/" class="btn btn-line">All {products.length} products <Icon name="arrow" stroke={2.4} /></a>
			</div>
			<div class="cat-grid">
				{productCats.map((c) => (
					<a class="cat reveal" href={`/products/#${c.id}`}>
						<div class="cat-photo"><IndustryArt id={catPhoto[c.id]} /></div>
						<div class="cat-body">
							<h3>{c.name}</h3>
							<p>{c.blurb}</p>
							<ul>{c.items.slice(0, 3).map((p) => <li>{p.name}</li>)}</ul>
							<span class="more">View {c.items.length} products <Icon name="arrow" size={15} stroke={2.4} /></span>
						</div>
					</a>
				))}
				<a class="cat cat-custom reveal" href="/contact/#enquiry">
					<div class="cat-body">
						<span class="eyebrow">Custom parts</span>
						<h3>Don't see your part?</h3>
						<p>Most of what we make is custom. Send a drawing, sample or photo with the material and quantity, and we'll quote for it.</p>
						<span class="more">Send your drawing <Icon name="arrow" size={15} stroke={2.4} /></span>
					</div>
				</a>
			</div>
		</div>
	</section>

	<!-- WHY CHOOSE US -->
	<Why tone="paper" />

	<!-- SERVICES & SUPPORT -->
	<section class="section" id="services">
		<div class="wrap svc-split">
			<div class="svc-media reveal">
				<Image src={servicePhoto} alt="Operator working at an open injection mould on a moulding machine" widths={[560, 900, 1200]} sizes="(max-width: 1050px) 100vw, 560px" />
				<div class="svc-badge"><b>One roof</b><span>Mould design, tooling, moulding, machining &amp; assembly</span></div>
			</div>
			<div class="reveal">
				<span class="eyebrow">Services &amp; support</span>
				<h2>From mould design to finished part.</h2>
				<p class="lede">One supplier for the whole job — so your part goes from drawing to delivery without being passed between vendors. Our team helps with material choice, mould design, trials and volume production.</p>
				<ul class="checklist">
					{services.map((s) => (
						<li><a href={`/services/${s.slug}/`}><Icon name="check" size={16} stroke={2.6} />{s.title}</a></li>
					))}
				</ul>
				<a href="/services/" class="btn btn-navy">All services <Icon name="arrow" stroke={2.4} /></a>
			</div>
		</div>
	</section>

	<!-- INDUSTRIES WE SERVE -->
	<section class="section comps" id="industries">
		<div class="wrap">
			<div class="head-row reveal">
				<div>
					<span class="eyebrow">Industries we serve</span>
					<h2>Parts for the machines<br />that keep India running.</h2>
				</div>
				<a href="/industries/" class="btn btn-line">All industries <Icon name="arrow" stroke={2.4} /></a>
			</div>
			<IndustryTabs />
		</div>
	</section>

	<!-- CLIENT TESTIMONIALS -->
	<Testimonials tone="plain" />

	<!-- CTA -->
	<Enquiry heading="Get your free custom moulding quote." />
</Layout>

<style>
	.hero { background: var(--navy); color: var(--on-navy); padding: 80px 0 0; position: relative; overflow: hidden; }
	.hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px) 0 0 / 100% 40px; pointer-events: none; }
	.hero-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; padding-bottom: 80px; }
	.since { display: inline-flex; align-items: center; gap: 10px; background: rgba(255,183,3,.12); border: 1px solid rgba(255,183,3,.35); color: var(--amber); border-radius: 999px; padding: 7px 14px; font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: .06em; }
	h1 { font-size: clamp(40px, 5.4vw, 68px); color: #fff; margin-top: 22px; }
	h1 span { color: var(--amber); }
	.hero .lede { color: var(--on-navy-2); }
	.hero-actions { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
	.hero-ticks { display: flex; gap: 22px; margin: 36px 0 0; padding: 0; list-style: none; flex-wrap: wrap; font-size: 14px; color: var(--on-navy-2); }
	.hero-ticks li { display: flex; gap: 8px; align-items: center; }
	.hero-ticks :global(svg) { color: var(--amber); }

	.hero-photo { position: relative; margin: 0; border-radius: 22px; overflow: hidden; border: 1px solid var(--navy-line); box-shadow: 0 40px 80px -30px rgba(0,0,0,.6); aspect-ratio: 4 / 3; background: #0b2038; }
	.hero-photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
	.hero-photo figcaption { position: absolute; left: 14px; bottom: 14px; right: 14px; max-width: max-content; background: rgba(11,32,56,.88); backdrop-filter: blur(6px); border: 1px solid var(--navy-line); border-radius: 12px; padding: 10px 14px; }
	.hero-photo figcaption b { display: block; color: #fff; font-size: 15px; }
	.hero-photo figcaption span { color: var(--on-navy-2); font-size: 13px; }

	.hero-stats { background: rgba(0,0,0,.18); border-top: 1px solid var(--navy-line); position: relative; }
	.hero-stats dl { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0 auto; }
	.hs { padding: 28px 20px; border-right: 1px solid var(--navy-line); }
	.hs:first-child { padding-left: 0; }
	.hs:last-child { border-right: 0; }
	.hs dt { color: #fff; font-size: 34px; font-weight: 800; letter-spacing: -.03em; line-height: 1.2; }
	.hs dt em { font-style: normal; color: var(--amber); }
	.hs dd { margin: 0; font-size: 14px; color: var(--on-navy-2); }

	/* What we make */
	.cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
	.cat { display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform .25s, box-shadow .25s, border-color .25s; }
	.cat:hover { transform: translateY(-5px); border-color: var(--blue); box-shadow: 0 24px 40px -28px rgba(15,42,74,.45); }
	.cat-photo { position: relative; aspect-ratio: 4 / 3; background: var(--blue-soft); overflow: hidden; }
	.cat-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
	.cat:hover .cat-photo :global(img) { transform: scale(1.04); }
	.cat-body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
	.cat h3 { font-size: 18px; }
	.cat p { color: var(--ink-2); font-size: 14.5px; margin: 8px 0 12px; }
	.cat ul { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 5px; font-size: 13.5px; color: var(--ink); flex: 1; }
	.cat li { display: flex; gap: 8px; align-items: center; }
	.cat li::before { content: ""; width: 6px; height: 6px; border-radius: 2px; background: var(--blue); flex: none; }
	.more { display: inline-flex; gap: 6px; align-items: center; font-weight: 700; font-size: 14px; color: var(--blue); }
	.cat-custom { background: var(--navy); border-color: var(--navy); color: var(--on-navy-2); justify-content: center; }
	.cat-custom .eyebrow { color: var(--amber); }
	.cat-custom h3 { color: #fff; font-size: 22px; margin-top: 10px; }
	.cat-custom p { color: var(--on-navy-2); flex: 1; }
	.cat-custom .more { color: var(--amber); }

	/* Services & support */
	.svc-split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
	.svc-media { position: relative; border-radius: 22px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--blue-soft); }
	.svc-media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
	.svc-badge { position: absolute; left: 16px; bottom: 16px; background: var(--amber); color: var(--navy); border-radius: 14px; padding: 12px 16px; max-width: 280px; }
	.svc-badge b { display: block; font-size: 18px; }
	.svc-badge span { font-size: 13.5px; color: #4a3a05; }
	.checklist { list-style: none; padding: 0; margin: 26px 0 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 20px; }
	.checklist a { display: flex; gap: 10px; align-items: center; font-weight: 600; font-size: 15px; }
	.checklist a:hover { color: var(--blue); }
	.checklist :global(svg) { color: var(--blue); flex: none; }

	@media (max-width: 1150px) { .cat-grid { grid-template-columns: repeat(3, 1fr); } }
	@media (max-width: 1050px) { .hero-grid, .svc-split { grid-template-columns: 1fr; } .svc-split { gap: 32px; } }
	@media (max-width: 860px) {
		.cat-grid { grid-template-columns: 1fr 1fr; }
		.hs, .hs:first-child { padding: 22px 14px; }
		.hs:first-child { padding-left: 0; }
	}
	@media (max-width: 600px) {
		.hero { padding-top: 56px; }
		.hero-photo figcaption { left: 10px; bottom: 10px; padding: 8px 12px; }
		.hero-photo figcaption span { display: none; }
		.hs dt { font-size: 28px; }
		.cat-grid, .checklist { grid-template-columns: 1fr; }
	}
</style>
