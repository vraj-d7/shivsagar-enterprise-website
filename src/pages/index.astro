---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import IndustryTabs from '../components/IndustryTabs.astro';
import Materials from '../components/Materials.astro';
import Process from '../components/Process.astro';
import Why from '../components/Why.astro';
import Enquiry from '../components/Enquiry.astro';
import { site, stats, services } from '../data/site';
---
<Layout>
	<!-- HERO -->
	<section class="hero">
		<div class="wrap hero-grid">
			<div>
				<span class="since">SINCE {site.since} · ANAND, GUJARAT</span>
				<h1>Your partner in <span>precision moulding.</span></h1>
				<p class="lede">Custom plastic injection-moulded and rubber components for motors, pumps, conveyors, dairy, chemical and automotive industries — from mould design to mass production, under one roof.</p>
				<div class="hero-actions">
					<a href="/contact/" class="btn btn-amber">Send your drawing for a quote <Icon name="arrow" stroke={2.4} /></a>
					<a href="/components/" class="btn btn-ghost">See components</a>
				</div>
				<ul class="hero-ticks">
					<li><Icon name="check" size={16} stroke={2.6} />In-house mould design</li>
					<li><Icon name="check" size={16} stroke={2.6} />Plastic + rubber</li>
					<li><Icon name="check" size={16} stroke={2.6} />Export-ready</li>
				</ul>
			</div>

			<div class="mould" role="img" aria-label="Illustration of an injection moulding machine filling a mould">
				<div class="mould-head"><span><b>INJECTION CYCLE</b> · Impeller, PP</span><span class="cycle">● RUNNING</span></div>
				<svg viewBox="0 0 480 280" aria-hidden="true">
					<defs>
						<clipPath id="cav"><path d="M300 90 h70 a10 10 0 0 1 10 10 v80 a10 10 0 0 1 -10 10 h-70 a10 10 0 0 1 -10 -10 v-80 a10 10 0 0 1 10 -10z" /></clipPath>
					</defs>
					<path d="M70 30 h70 l-20 40 h-30z" fill="#163a63" stroke="#2c5a8f" />
					<g fill="#ffb703"><circle cx="92" cy="44" r="4" /><circle cx="104" cy="50" r="4" /><circle cx="116" cy="42" r="4" /><circle cx="100" cy="38" r="4" /></g>
					<rect x="30" y="118" width="220" height="44" rx="8" fill="#163a63" stroke="#2c5a8f" />
					<g fill="#ff6b3d" opacity=".9"><rect x="70" y="112" width="18" height="56" rx="3" /><rect x="120" y="112" width="18" height="56" rx="3" /><rect x="170" y="112" width="18" height="56" rx="3" /></g>
					<path d="M105 70 V118" stroke="#2c5a8f" stroke-width="8" />
					<g stroke="#7f97b8" stroke-width="3" fill="none">
						<path d="M40 140 H240" />
						<path d="M60 128 l10 24 M80 128 l10 24 M100 128 l10 24 M120 128 l10 24 M140 128 l10 24 M160 128 l10 24 M180 128 l10 24 M200 128 l10 24">
							<animateTransform attributeName="transform" type="translate" values="0 0;20 0;0 0" dur="3s" repeatCount="indefinite" />
						</path>
					</g>
					<path d="M250 128 h20 l10 8 v8 l-10 8 h-20z" fill="#2c5a8f" />
					<rect x="282" y="60" width="54" height="160" rx="6" fill="#2a4d78" stroke="#3b6aa3" />
					<rect x="344" y="60" width="54" height="160" rx="6" fill="#2a4d78" stroke="#3b6aa3" />
					<path d="M300 90 h70 a10 10 0 0 1 10 10 v80 a10 10 0 0 1 -10 10 h-70 a10 10 0 0 1 -10 -10 v-80 a10 10 0 0 1 10 -10z" fill="#0b2038" stroke="#5b86bd" stroke-dasharray="4 4" />
					<g clip-path="url(#cav)">
						<rect x="290" y="190" width="100" height="100" fill="#ffb703">
							<animate attributeName="y" values="190;90;90;190" keyTimes="0;.55;.85;1" dur="3s" repeatCount="indefinite" />
						</rect>
					</g>
					<rect x="404" y="110" width="50" height="60" rx="6" fill="#163a63" stroke="#2c5a8f" />
					<path d="M398 140 h6" stroke="#7f97b8" stroke-width="6" />
					<g font-family="Space Mono, monospace" font-size="9" fill="#7f97b8">
						<text x="64" y="24">HOPPER</text><text x="110" y="190">HEATED BARREL</text><text x="306" y="240">MOULD</text><text x="406" y="186">CLAMP</text>
					</g>
				</svg>
				<div class="mould-foot">
					<div class="mf"><small>Parts / day</small><strong>40,000+</strong></div>
					<div class="mf"><small>Rubber / day</small><strong>5,000+</strong></div>
					<div class="mf"><small>Materials</small><strong>10+</strong></div>
				</div>
			</div>
		</div>

		<div class="hero-stats">
			<dl class="wrap">
				{stats.map((s) => (
					<div class="hs"><dt>{s.value}{s.unit && <em>{s.unit}</em>}</dt><dd>{s.label}</dd></div>
				))}
			</dl>
		</div>
	</section>

	<!-- SERVICES -->
	<section class="section" id="services">
		<div class="wrap">
			<div class="head-row reveal">
				<div>
					<span class="eyebrow">What we do</span>
					<h2>From mould design<br />to finished part.</h2>
				</div>
				<p class="lede">One supplier for the whole job — so your part goes from drawing to delivery without being passed between vendors.</p>
			</div>
			<div class="svc-grid">
				{services.map((s) => (
					<a href={`/services/#${s.slug}`} class:list={['svc', 'reveal', { lead: s.lead }]}>
						<div>
							<div class="ic"><Icon name={s.icon} /></div>
							<h3>{s.title}</h3>
							<p>{s.short}</p>
						</div>
						{s.lead && <ul class="dots">{s.points.map((p) => <li>{p}</li>)}</ul>}
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- COMPONENTS -->
	<section class="section comps" id="industries">
		<div class="wrap">
			<div class="head-row reveal">
				<div>
					<span class="eyebrow">Components we make</span>
					<h2>Parts for the machines<br />that keep India running.</h2>
				</div>
				<a href="/components/" class="btn btn-line">All components <Icon name="arrow" stroke={2.4} /></a>
			</div>
			<IndustryTabs />
		</div>
	</section>

	<Materials />
	<Process />
	<Why />
	<Enquiry />
</Layout>

<style>
	.hero { background: var(--navy); color: var(--on-navy); padding: 80px 0 0; position: relative; overflow: hidden; }
	.hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px) 0 0 / 100% 40px; pointer-events: none; }
	.hero-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; padding-bottom: 80px; }
	.since { display: inline-flex; align-items: center; gap: 10px; background: rgba(255,183,3,.12); border: 1px solid rgba(255,183,3,.35); color: var(--amber); border-radius: 999px; padding: 7px 14px; font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: .06em; }
	h1 { font-size: clamp(40px, 5.4vw, 68px); color: #fff; margin-top: 22px; }
	h1 span { color: var(--amber); }
	.hero .lede { color: var(--on-navy-2); }
	.hero-actions { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
	.hero-ticks { display: flex; gap: 22px; margin: 36px 0 0; padding: 0; list-style: none; flex-wrap: wrap; font-size: 14px; color: var(--on-navy-2); }
	.hero-ticks li { display: flex; gap: 8px; align-items: center; }
	.hero-ticks :global(svg) { color: var(--amber); }

	.mould { background: #0b2038; border: 1px solid var(--navy-line); border-radius: 22px; padding: 18px; box-shadow: 0 40px 80px -30px rgba(0,0,0,.6); }
	.mould-head { display: flex; justify-content: space-between; gap: 10px; font-family: var(--mono); font-size: 11px; color: #7f97b8; padding: 2px 4px 12px; }
	.mould-head b { color: #fff; }
	.cycle { color: var(--amber); white-space: nowrap; }
	.mould svg { width: 100%; height: auto; }
	.mould-foot { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }
	.mf { background: rgba(255,255,255,.04); border: 1px solid var(--navy-line); border-radius: 10px; padding: 10px 12px; }
	.mf small { display: block; font-family: var(--mono); font-size: 10px; color: #7f97b8; letter-spacing: .06em; text-transform: uppercase; }
	.mf strong { color: #fff; font-size: 17px; }

	.hero-stats { background: rgba(0,0,0,.18); border-top: 1px solid var(--navy-line); position: relative; }
	.hero-stats dl { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 auto; }
	.hs { padding: 28px 20px; border-right: 1px solid var(--navy-line); }
	.hs:first-child { padding-left: 0; }
	.hs:last-child { border-right: 0; }
	.hs dt { color: #fff; font-size: 34px; font-weight: 800; letter-spacing: -.03em; line-height: 1.2; }
	.hs dt em { font-style: normal; color: var(--amber); }
	.hs dd { margin: 0; font-size: 14px; color: var(--on-navy-2); }

	@media (max-width: 1050px) { .hero-grid { grid-template-columns: 1fr; } }
	@media (max-width: 860px) {
		.hero-stats dl { grid-template-columns: 1fr 1fr; }
		.hs, .hs:first-child { padding: 22px 14px; border-bottom: 1px solid var(--navy-line); }
		.hs:nth-child(odd) { padding-left: 0; }
		.hs:nth-child(2) { border-right: 0; }
		.hs:nth-child(n+3) { border-bottom: 0; }
	}
	@media (max-width: 600px) {
		.hero { padding-top: 56px; }
		.hs dt { font-size: 28px; }
		.mould-foot { grid-template-columns: 1fr 1fr; }
		.mould-foot .mf:last-child { grid-column: span 2; }
		.mould-head { flex-direction: column; }
	}
</style>
