---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — Precision plastic & rubber moulding since ${site.since}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const org = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: site.name,
	description: site.description,
	url: Astro.site?.toString(),
	telephone: site.phone.replace(/\s/g, ''),
	email: site.email,
	foundingDate: String(site.since),
	address: { '@type': 'PostalAddress', streetAddress: 'GIDC, V.U. Nagar', addressLocality: 'Anand', addressRegion: 'Gujarat', addressCountry: 'IN' },
};
---
<!doctype html>
<html lang="en-IN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:image" content={new URL("/icon-512.png", Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#0f2a4a" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={site.name} />
		{noindex && <meta name="robots" content="noindex" />}
		<script type="application/ld+json" set:html={JSON.stringify(org)} />
		<script is:inline>
			(function () {
				if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Header />
		<main id="main" tabindex="-1"><slot /></main>
		<Footer />
		<script>
			import '../scripts/smooth-scroll';
		</script>

		<!-- Load & scroll reveal, ported from atcrubbers.com. Inline so elements are tagged before first paint. -->
		<script is:inline>
			(() => {
				const motion = document.documentElement.classList.contains('motion');
				if (!motion || !('IntersectionObserver' in window)) {
					document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
					return;
				}

				// Fade up: hero copy, page heroes, headings, cards, lists and the footer.
				const fadeUp = [
					'.page-hero .wrap > *',
					'.hero-grid > div:first-child > *',
					'.hs',
					'.g-head',
					'.catalogue .card',
					'.filters',
					'.cards > .card',
					'.intro-text > *',
					'.map-grid > div',
					'.side .box',
					'.numbers dl > div',
					'.steps > li',
					'.foot > *',
					'.foot-bottom',
				];
				// Zoom in: big photos and the map.
				const zoom = ['.hero-photo', '.svc-media', '.map', '.body-wrap .cover'];

				const mark = (selectors, extra) =>
					document.querySelectorAll(selectors.join(',')).forEach((el) => el.classList.add('reveal', ...extra));
				mark(fadeUp, []);
				mark(zoom, ['reveal--zoom']);

				// Reveal a batch of elements in page order, staggered 90ms apart.
				const reveal = (els) =>
					els
						.sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1))
						.forEach((el, i) => {
							el.style.setProperty('--reveal-delay', `${Math.min(i, 8) * 90}ms`);
							el.classList.add('in');
						});

				const observer = new IntersectionObserver(
					(entries) => {
						const els = entries.filter((e) => e.isIntersecting).map((e) => e.target);
						els.forEach((el) => observer.unobserve(el));
						reveal(els);
					},
					{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
				);

				// Whatever is already on screen animates in straight away; the rest waits until it's scrolled into view.
				// (Some browsers deliver the first IntersectionObserver callback late, which would leave the hero blank.)
				const all = [...document.querySelectorAll('.reveal')];
				const fold = innerHeight * 0.94;
				const onScreen = all.filter((el) => {
					const r = el.getBoundingClientRect();
					return r.width > 0 && r.top < fold && r.bottom > 0;
				});
				reveal(onScreen);
				all.filter((el) => !onScreen.includes(el)).forEach((el) => observer.observe(el));
			})();
		</script>
	</body>
</html>
