---
// Photo for each industry panel. Images are cropped from Shiv Sagar's own website imagery
// and live in src/assets/industries/<industry id>.jpg.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { id: string; eager?: boolean }
const { id, eager = false } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/industries/*.jpg', { eager: true });
const alts: Record<string, string> = {
	motors: 'Electric motor stators fitted into white moulded plastic housings on an assembly line',
	pumps: 'Centrifugal pump with a blue electric motor',
	conveyors: 'Bottles moving along a conveyor line',
	dairy: 'Stainless steel dairy pump with white food-grade pipe fittings',
	chemical: 'Process pipework and valves with black rubber sealing rings',
	automotive: 'A steel injection mould held next to the black moulded plastic part it produces',
	rubber: 'Black rubber O-rings, a bellows, a flange gasket and red silicone parts laid out on a steel table',
};
const photo = photos[`../assets/industries/${id}.jpg`]?.default;
---
{photo && (
	<Image src={photo} alt={alts[id] ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 1050px) 100vw, 520px" loading={eager ? 'eager' : 'lazy'} />
)}
