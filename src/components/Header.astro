---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
const path = Astro.url.pathname;
---
<div class="topbar">
	<div class="wrap">
		<span><Icon name="pin" size={14} />{site.address}</span>
		<span class="tb-right">
			<a href={site.phoneHref}><Icon name="phone" size={14} />{site.phone}</a>
			<a class="hide-sm" href={`mailto:${site.email}`}><Icon name="mail" size={14} />{site.email}</a>
		</span>
	</div>
</div>

<header class="nav" id="nav">
	<div class="wrap">
		<a href="/" class="logo" aria-label={`${site.name} home`}>
			<Logo height={38} class="logo-img" />
		</a>
		<nav class="links" id="links" aria-label="Main">
			{nav.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
		</nav>
		<button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="links">
			<Icon name="menu" size={18} class="i-open" /><Icon name="close" size={18} class="i-close" />
		</button>
	</div>
</header>

<script>
	const nav = document.getElementById('nav')!;
	const btn = document.getElementById('menuBtn')!;
	const set = (open: boolean) => {
		nav.classList.toggle('open', open);
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	};
	btn.addEventListener('click', () => set(!nav.classList.contains('open')));
	document.querySelectorAll('#links a').forEach((a) => a.addEventListener('click', () => set(false)));
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>

<style>
	.topbar { background: var(--navy); color: #b8c6da; font-size: 13px; }
	.topbar .wrap { display: flex; justify-content: space-between; gap: 16px; padding-top: 9px; padding-bottom: 9px; flex-wrap: wrap; }
	.topbar span, .topbar a { display: inline-flex; gap: 8px; align-items: center; }
	.tb-right { gap: 18px !important; }
	.topbar :global(svg) { color: var(--amber); }
	.topbar a:hover { color: #fff; }
	.nav { position: sticky; top: 0; z-index: 40; background: rgba(247,245,240,.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
	.nav .wrap { height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
	.logo { display: flex; align-items: center; flex: 0 1 auto; min-width: 0; }
	.logo :global(.logo-img) { display: block; height: 38px; width: auto; max-width: 100%; }
	@media (max-width: 420px) { .logo :global(.logo-img) { height: 30px; } }
	.links { display: flex; gap: 30px; font-weight: 600; font-size: 15px; color: var(--ink-2); }
	.links a:not(.btn):hover, .links a[aria-current="page"] { color: var(--blue); }
	.menu-btn { display: none; width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--line); background: #fff; cursor: pointer; color: var(--ink); }
	.menu-btn :global(.i-close) { display: none; }
	.nav.open .menu-btn :global(.i-open) { display: none; }
	.nav.open .menu-btn :global(.i-close) { display: block; }

	@media (max-width: 860px) {
		.links, .topbar .hide-sm { display: none; }
		.menu-btn { display: grid; place-items: center; }
		.nav.open .links { display: flex; flex-direction: column; gap: 0; position: absolute; top: 72px; left: 0; right: 0; background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: 0 20px 30px -20px rgba(15,42,74,.3); }
		.nav.open .links a:not(.btn) { padding: 16px 24px; border-top: 1px solid var(--line); }
	}
</style>
