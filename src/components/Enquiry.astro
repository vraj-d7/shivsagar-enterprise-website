---
import Icon from './Icon.astro';
import { site, industries } from '../data/site';
interface Props { heading?: string }
const { heading = 'Get a quote for your part.' } = Astro.props;
---
<div class="enq" id="enquiry">
	<div class="wrap">
		<div class="enq-box reveal">
			<div class="enq-left">
				<h2>{heading}</h2>
				<p>Tell us the part, material and quantity, and we'll come back with a quote.</p>
				<div class="cl">
					<a href={site.phoneHref}><Icon name="phone" /><div><small>Call</small><b>{site.phone}</b></div></a>
					<a href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="chat" /><div><small>WhatsApp</small><b>Send a photo or drawing</b></div></a>
					<a href={`mailto:${site.email}`}><Icon name="mail" /><div><small>Email</small><b>{site.email}</b></div></a>
					<a href={site.mapHref} target="_blank" rel="noopener"><Icon name="pin" /><div><small>Factory</small><b>{site.address}</b></div></a>
				</div>
			</div>
			<form class="form" id="quote-form" data-email={site.email} novalidate>
				<h3>Request a quote</h3>
				<p class="intro">Pressing send opens your email app with the enquiry ready to go. Attach your drawing there.</p>
				<div class="row">
					<div class="field"><label for="q-name">Name <i>*</i></label><input id="q-name" name="name" autocomplete="name" placeholder="Your name" required /></div>
					<div class="field"><label for="q-company">Company</label><input id="q-company" name="company" autocomplete="organization" placeholder="Company name" /></div>
				</div>
				<div class="row">
					<div class="field"><label for="q-phone">Phone <i>*</i></label><input id="q-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91" required /></div>
					<div class="field"><label for="q-ind">Industry</label>
						<select id="q-ind" name="industry">
							{industries.map((i) => <option>{i.tab}</option>)}
							<option>Other</option>
						</select>
					</div>
				</div>
				<div class="field"><label for="q-msg">Part details <i>*</i></label><textarea id="q-msg" name="message" placeholder="Part, material, quantity per month…" required></textarea></div>
				<p class="error" role="alert" hidden>Please fill in your name, phone and part details.</p>
				<button class="btn btn-navy" type="submit">Send enquiry <Icon name="arrow" stroke={2.4} /></button>
			</form>
		</div>
	</div>
</div>

<script>
	const form = document.getElementById('quote-form') as HTMLFormElement | null;
	if (form) {
		const error = form.querySelector<HTMLElement>('.error')!;
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
			const required = ['name', 'phone', 'message'];
			const missing = required.filter((k) => !data[k]?.trim());
			required.forEach((k) => {
				const el = form.elements.namedItem(k) as HTMLElement;
				if (missing.includes(k)) el.setAttribute('aria-invalid', 'true');
				else el.removeAttribute('aria-invalid');
			});
			error.hidden = missing.length === 0;
			if (missing.length) { (form.elements.namedItem(missing[0]) as HTMLElement).focus(); return; }
			const subject = `Quote enquiry from ${data.name}${data.company ? ` (${data.company})` : ''}`;
			const lines = [`Name: ${data.name}`];
			if (data.company) lines.push(`Company: ${data.company}`);
			lines.push(`Phone: ${data.phone}`, `Industry: ${data.industry}`, '', data.message);
			const body = lines.join('\n');
			location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		});
	}
</script>

<style>
	.enq { padding: 0 0 100px; }
	@media (max-width: 600px) { .enq { padding-bottom: 76px; } }
</style>
