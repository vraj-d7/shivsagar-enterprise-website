---
import { testimonials } from '../data/site';
interface Props { tone?: 'plain' | 'paper' }
const { tone = 'paper' } = Astro.props;
---
<section class:list={['section', 'tst-sec', { 'tone-paper': tone === 'paper' }]}>
	<div class="wrap">
		<div class="head-row reveal">
			<div>
				<span class="eyebrow">What clients say</span>
				<h2>Trusted by the people<br />who build with our parts.</h2>
			</div>
		</div>
		<div class="tst-grid">
			{testimonials.map((t) => (
				<figure class="tst reveal">
					<span class="mark" aria-hidden="true">“</span>
					<blockquote>{t.quote}</blockquote>
					<figcaption><b>{t.name}</b><span>{t.role}</span></figcaption>
				</figure>
			))}
		</div>
	</div>
</section>

<style>
	.tst-sec:not(.tone-paper) .tst { background: var(--paper); }
	.tst-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
	.tst { margin: 0; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; display: flex; flex-direction: column; }
	.mark { font-size: 56px; line-height: .8; font-weight: 800; color: var(--amber); }
	blockquote { margin: 10px 0 24px; color: var(--ink-2); font-size: 15.5px; flex: 1; }
	figcaption b { display: block; }
	figcaption span { font-size: 13.5px; color: var(--muted); }
	@media (max-width: 1050px) { .tst-grid { grid-template-columns: 1fr; } }
</style>
