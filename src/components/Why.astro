---
import { why } from '../data/site';
interface Props { tone?: 'plain' | 'paper' }
const { tone = 'plain' } = Astro.props;
---
<section class:list={['section', { 'tone-paper': tone === 'paper' }]}>
	<div class="wrap">
		<div class="head-row reveal">
			<div>
				<span class="eyebrow">Why choose us</span>
				<h2>Local roots. Global reach.</h2>
			</div>
		</div>
		<div class="why-grid">
			{why.map((w, i) => (
				<div class="why reveal"><span class="k">{String(i + 1).padStart(2, '0')}</span><h3>{w.title}</h3><p>{w.text}</p></div>
			))}
		</div>
	</div>
</section>
