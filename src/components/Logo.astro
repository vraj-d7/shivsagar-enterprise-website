---
// Shiv Sagar Enterprise's own logo (blue "SS" with red swoosh + wordmark), taken from the old website.
// Source files: src/assets/brand/logo.png (full) and logo-mark.png (symbol only).
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import mark from '../assets/brand/logo-mark.png';
interface Props { variant?: 'full' | 'mark'; height?: number; class?: string }
const { variant = 'full', height = 40, class: cls } = Astro.props;
const src = variant === 'mark' ? mark : logo;
const width = Math.round((src.width / src.height) * height);
---
<Image src={src} alt="Shiv Sagar Enterprise" width={width} height={height} densities={[1, 2]} loading="eager" class={cls} />
