---
import { materials } from '../data/site';
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
---
<section class="section" id="materials">
	<div class="wrap mat-wrap">
		<div class="reveal">
			<span class="eyebrow">Materials</span>
			<h2>The right material for the job.</h2>
			<p class="lede">We help you choose between commodity plastics, engineering polymers, fluoropolymers and rubber — balancing strength, chemical resistance, temperature and cost.</p>
			<div class="legend"><span><i style="background:var(--blue)"></i>Plastics</span><span><i style="background:var(--rubber)"></i>Rubber</span></div>
		</div>
		<div class="chips reveal">
			{materials.map((m) => (
				<div class={`chip ${m.kind}`}>
					<b>{m.name}</b><span>{m.note}</span>
					{detailed && <p class="use">{m.use}</p>}
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.use { margin: 8px 0 0; font-size: 13.5px; line-height: 1.5; color: var(--ink-2); }
</style>
